<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tms_budget_list" model="ir.ui.view">
        <field name="name">tms.budget.list</field>
        <field name="model">tms.budget</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'over'" decoration-warning="state == 'warning'">
                <field name="cost_center_id"/><field name="fiscal_year"/><field name="category"/><field name="period"/>
                <field name="amount" sum="Budget"/><field name="actual" sum="Réalisé"/><field name="gap" sum="Écart"/>
                <field name="consumed_pct" widget="progressbar"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_tms_budget_form" model="ir.ui.view">
        <field name="name">tms.budget.form</field>
        <field name="model">tms.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_lines" string="Voir le réalisé" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="cost_center_id"/><field name="fiscal_year"/><field name="category"/>
                            <field name="period"/><field name="period_number" invisible="period == 'year'"/>
                        </group>
                        <group>
                            <field name="amount"/><field name="threshold"/><field name="actual"/>
                            <field name="gap"/><field name="consumed_pct" widget="progressbar"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_tms_budget_search" model="ir.ui.view">
        <field name="name">tms.budget.search</field>
        <field name="model">tms.budget</field>
        <field name="arch" type="xml">
            <search>
                <field name="cost_center_id"/><field name="fiscal_year"/>
                <filter name="over" string="Dépassés / seuil atteint" domain="[('state', '!=', 'ok')]"/>
                <group>
                    <filter name="g_cc" string="Centre de coût" context="{'group_by': 'cost_center_id'}"/>
                    <filter name="g_year" string="Exercice" context="{'group_by': 'fiscal_year'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_budget" model="ir.actions.act_window">
        <field name="name">Suivi budgétaire</field>
        <field name="res_model">tms.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Analyse des charges par centre de coût / catégorie -->
    <record id="view_analytic_line_pivot_tms" model="ir.ui.view">
        <field name="name">account.analytic.line.pivot.tms</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <pivot string="Charges par centre de coût">
                <field name="account_id" type="row"/>
                <field name="tms_category" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_tms_cost_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des charges</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="domain">[('account_id.plan_id.name', '=', 'Centres de coût')]</field>
    </record>

    <menuitem id="menu_tms_budget_root" name="Contrôle de gestion" parent="tms_fleet.menu_tms_root" sequence="95" groups="tms_fleet.group_tms_user"/>
    <menuitem id="menu_tms_budget" name="Budgets" parent="menu_tms_budget_root" sequence="1" action="action_tms_budget"/>
    <menuitem id="menu_tms_cost_analysis" name="Analyse des charges" parent="menu_tms_budget_root" sequence="2" action="action_tms_cost_analysis"/>
</odoo>
