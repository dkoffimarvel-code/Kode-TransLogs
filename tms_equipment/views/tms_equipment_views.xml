<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_form_tms" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.tms</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Exploitation TMS" name="tms_equipment">
                    <group>
                        <group>
                            <field name="tms_state"/><field name="tms_site_id"/><field name="cost_center_id"/>
                            <field name="commissioning_date"/>
                        </group>
                        <group>
                            <field name="next_control_date"/><field name="control_interval_months"/>
                            <field name="last_intervention_date"/><field name="maintenance_cost_total"/>
                        </group>
                    </group>
                    <field name="intervention_ids">
                        <list><field name="date"/><field name="intervention_type"/><field name="provider_id"/>
                            <field name="cost"/><field name="cost_center_id"/><field name="state"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_tms_eq_int_form" model="ir.ui.view">
        <field name="name">tms.equipment.intervention.form</field>
        <field name="model">tms.equipment.intervention</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Marquer réalisée" type="object" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="equipment_id"/><field name="date"/><field name="intervention_type"/><field name="provider_id"/></group>
                        <group><field name="cost"/><field name="cost_center_id"/><field name="currency_id" invisible="1"/></group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_tms_eq_int_list" model="ir.ui.view">
        <field name="name">tms.equipment.intervention.list</field>
        <field name="model">tms.equipment.intervention</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="equipment_id"/><field name="intervention_type"/>
                <field name="provider_id"/><field name="cost" sum="Total"/><field name="cost_center_id"/><field name="state"/></list>
        </field>
    </record>
    <record id="action_tms_eq_int" model="ir.actions.act_window">
        <field name="name">Interventions sur engins</field>
        <field name="res_model">tms.equipment.intervention</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
    <record id="action_tms_equipment" model="ir.actions.act_window">
        <field name="name">Parc d'engins</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_tms_equipment_root" name="Engins" parent="tms_fleet.menu_tms_root" sequence="80" groups="tms_fleet.group_tms_user"/>
    <menuitem id="menu_tms_equipment" name="Parc d'engins" parent="menu_tms_equipment_root" sequence="1" action="action_tms_equipment"/>
    <menuitem id="menu_tms_eq_int" name="Interventions" parent="menu_tms_equipment_root" sequence="2" action="action_tms_eq_int"/>
</odoo>
