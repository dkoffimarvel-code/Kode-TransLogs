<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_tms_document_expiry" model="ir.cron">
        <field name="name">TMS : alertes d'expiration des documents</field>
        <field name="model_id" ref="model_tms_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_tms_maintenance_alerts" model="ir.cron">
        <field name="name">TMS : alertes de maintenance préventive</field>
        <field name="model_id" ref="model_tms_maintenance_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_tms_reports" model="ir.cron">
        <field name="name">TMS : envoi des rapports programmés</field>
        <field name="model_id" ref="model_tms_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
