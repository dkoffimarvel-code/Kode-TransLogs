<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="analytic_plan_cost_center" model="account.analytic.plan">
        <field name="name">Centres de coût</field>
    </record>
    <record id="seq_tms_tour" model="ir.sequence">
        <field name="name">Tournée</field>
        <field name="code">tms.tour</field>
        <field name="prefix">TOU/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_tms_incident" model="ir.sequence">
        <field name="name">Incident</field>
        <field name="code">tms.incident</field>
        <field name="prefix">INC/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="param_gps_token" model="ir.config_parameter">
        <field name="key">tms_fleet.gps_token</field>
        <field name="value">CHANGE-ME</field>
    </record>
</odoo>
