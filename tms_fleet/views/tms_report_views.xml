<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tms_report_form" model="ir.ui.view">
        <field name="name">tms.report.schedule.form</field>
        <field name="model">tms.report.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_send_now" string="Envoyer maintenant" type="object"/></header>
                <sheet>
                    <group>
                        <field name="name"/><field name="report_type"/><field name="periodicity"/>
                        <field name="export_format"/><field name="recipient_ids" widget="many2many_tags"/>
                        <field name="last_sent"/><field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_tms_report_list" model="ir.ui.view">
        <field name="name">tms.report.schedule.list</field>
        <field name="model">tms.report.schedule</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="report_type"/><field name="periodicity"/><field name="last_sent"/></list>
        </field>
    </record>
    <record id="action_tms_report" model="ir.actions.act_window">
        <field name="name">Rapports programmés</field>
        <field name="res_model">tms.report.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
