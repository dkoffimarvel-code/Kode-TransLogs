<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tms_tour_form" model="ir.ui.view">
        <field name="name">tms.tour.form</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" string="Planifier" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Démarrer" type="object" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_done" string="Terminer" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_create_invoice" string="Facturer" type="object"
                            invisible="state != 'done' or invoice_id or not customer_id"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" string="Remettre en brouillon" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="departure_time" widget="float_time"/>
                            <field name="zone"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="cost_center_id"/>
                            <field name="distance_km"/>
                            <field name="empty_km"/>
                            <field name="on_time"/>
                            <field name="customer_id"/>
                            <field name="billing_mode"/>
                            <field name="unit_price"/>
                            <field name="amount_to_invoice"/>
                            <field name="invoice_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Points de livraison">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="window_start" widget="float_time"/>
                                    <field name="window_end" widget="float_time"/>
                                    <field name="weight"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_tms_tour_list" model="ir.ui.view">
        <field name="name">tms.tour.list</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == 'urgent'">
                <field name="name"/><field name="date"/><field name="driver_id"/><field name="vehicle_id"/>
                <field name="zone"/><field name="priority"/><field name="cost_center_id" optional="show"/>
                <field name="distance_km" optional="show"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_tms_tour_kanban" model="ir.ui.view">
        <field name="name">tms.tour.kanban</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div><field name="zone"/> · <field name="date"/></div>
                        <div><field name="driver_id"/> / <field name="vehicle_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Planning hebdomadaire : une ligne par conducteur, une colonne par jour -->
    <record id="view_tms_tour_gantt_pivot" model="ir.ui.view">
        <field name="name">tms.tour.pivot</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <pivot string="Planning des tournées">
                <field name="driver_id" type="row"/>
                <field name="date" interval="day" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="view_tms_tour_calendar" model="ir.ui.view">
        <field name="name">tms.tour.calendar</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <calendar date_start="date" color="driver_id" mode="week" string="Tournées">
                <field name="driver_id"/><field name="zone"/>
            </calendar>
        </field>
    </record>
    <record id="view_tms_tour_search" model="ir.ui.view">
        <field name="name">tms.tour.search</field>
        <field name="model">tms.tour</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="driver_id"/><field name="vehicle_id"/><field name="zone"/>
                <filter name="urgent" string="Urgentes" domain="[('priority', '=', 'urgent')]"/>
                <filter name="to_invoice" string="À facturer" domain="[('state', '=', 'done'), ('invoice_id', '=', False)]"/>
                <group>
                    <filter name="g_driver" string="Conducteur" context="{'group_by': 'driver_id'}"/>
                    <filter name="g_cc" string="Centre de coût" context="{'group_by': 'cost_center_id'}"/>
                    <filter name="g_state" string="Statut" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tms_tour" model="ir.actions.act_window">
        <field name="name">Tournées</field>
        <field name="res_model">tms.tour</field>
        <field name="view_mode">kanban,list,calendar,pivot,form</field>
    </record>
</odoo>
