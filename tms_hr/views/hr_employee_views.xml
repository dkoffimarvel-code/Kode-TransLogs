<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_tms_hr" model="ir.ui.view">
        <field name="name">hr.employee.form.tms.hr</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contrat &amp; habilitations" name="tms_hr_contract">
                    <group>
                        <group>
                            <field name="tms_job_category"/>
                            <field name="tms_contract_type"/>
                            <field name="tms_contract_end"/>
                            <field name="tms_base_salary" groups="hr.group_hr_user"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="hr_employee_search_tms_hr" model="ir.ui.view">
        <field name="name">hr.employee.search.tms.hr</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="contract_due" string="Contrats à échéance (30 j)" domain="[('tms_contract_due_soon', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
